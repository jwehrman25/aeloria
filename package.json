{
  "name": "aeloria-wiki",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "start": "npm run dev",
    "sync-with-dropbox": "powershell -ExecutionPolicy Bypass -File sync-docs.ps1",
    "deploy": "gh-pages -d dist",
    "build-and-deploy": "npm run sync-with-dropbox && npm run build && npm run deploy"
  },
  "dependencies": {
    "@primeuix/themes": "^2.0.3",
    "axios": "^1.16.0",
    "bootstrap": "^5.3.8",
    "dropbox": "^10.34.0",
    "markdown-it": "^14.1.1",
    "pinia": "^3.0.4",
    "primevue": "^4.5.5",
    "sass-embedded": "^1.99.0",
    "vue": "^3.5.32",
    "vue-router": "^5.0.4"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.4",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.12.2",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/tsconfig": "^0.9.1",
    "gh-pages": "^6.3.0",
    "npm-run-all2": "^8.0.4",
    "typescript": "~6.0.0",
    "vite": "^8.0.8",
    "vite-plugin-vue-devtools": "^8.1.1",
    "vue-tsc": "^3.2.6"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
